{
  "name": "pm:executeAzureReposActions",
  "description": "Execute Azure Repos-targeted action items by creating branches and pull requests via MCP. Processes action items with target='azure-repos' (distinct from azure-devops Boards).",
  "creator": "Covia PM",
  "dateCreated": "2026-02-23T00:00:00Z",
  "keywords": ["azure-repos", "pull-requests", "branches", "version-control", "mcp"],
  "operation": {
    "adapter": "orchestrator",
    "input": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "description": "Array of action items to execute (filtered to target='azure-repos')",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "description": { "type": "string" },
              "assignee": { "type": "string" },
              "priority": { "type": "string" },
              "metadata": { "type": "object" }
            }
          }
        },
        "azureReposServer": { "type": "string", "description": "MCP server URL for Azure Repos integration" },
        "project": { "type": "string", "description": "Azure DevOps project name" },
        "token": { "type": "string", "secret": true, "description": "Azure DevOps personal access token" }
      },
      "required": ["actions", "azureReposServer", "project"]
    },
    "output": {
      "type": "object",
      "properties": {
        "results": { "type": "array", "description": "Results from each Azure Repos operation" },
        "summary": { "type": "object", "description": "Summary of execution results" }
      }
    },
    "steps": [
      {
        "op": "mcp:tools:call",
        "name": "Execute Azure Repos Actions",
        "input": {
          "server": ["input", "azureReposServer"],
          "toolName": ["const", "create_pull_request"],
          "arguments": {
            "project": ["input", "project"],
            "actions": ["input", "actions"]
          },
          "token": ["input", "token"]
        }
      }
    ],
    "result": {
      "results": [0, "result"],
      "summary": [0, "summary"]
    }
  }
}
